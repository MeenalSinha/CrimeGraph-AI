# Backend
CRIMEGRAPH_SECRET_KEY=change-this-in-production
CRIMEGRAPH_CORS_ORIGINS=http://localhost:3000
CRIMEGRAPH_CITY_NAME=Novagarh
CRIMEGRAPH_SEED=42
CRIMEGRAPH_N_PERSONS=600
CRIMEGRAPH_N_FIRS=2500
CRIMEGRAPH_N_DAYS=365
# Optional: set to enable LLM-composed chat answers (still fact-grounded by the
# real services). Leave unset and the platform runs fully offline.
OPENAI_API_KEY=

# Optional: set to a real PostgreSQL connection string to use the production
# database backend instead of the zero-config in-memory CSV backend. Verified
# against a real PostgreSQL 16 instance -- see AUDIT.md and scripts/verify_database.py.
CRIMEGRAPH_DATABASE_URL=

# Frontend
NEXT_PUBLIC_API_BASE=http://localhost:8000
# Optional: set to a real Mapbox access token (from https://account.mapbox.com)
# to switch the crime map from the built-in SVG fallback to real Mapbox GL tiles.
# Leave blank and the platform runs with zero external map keys.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Mobile (mobile/app.json -> expo.extra.apiBase, or this env var)
EXPO_PUBLIC_API_BASE=http://localhost:8000
